{
  "name": "json-custom-view-monorepo",
  "private": true,
  "description": "Monorepo for json-custom-view and its framework wrappers",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "editorconfig": "editorconfig-checker",
    "start": "npm start -w json-custom-view"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polina-prokofieva/json-custom-view.git"
  },
  "author": "Polina Prokofieva",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "editorconfig-checker": "^5.0.1",
    "eslint": "^9.20.0",
    "typescript": "^7.0.2"
  }
}
