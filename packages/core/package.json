{
  "name": "json-custom-view",
  "version": "1.2.6",
  "description": "Customizable JSON viewer for the browser. Renders JSON data as a collapsible HTML tree or tables, with settings to hide, format and transform values. Written in TypeScript, no dependencies.",
  "main": "build/api.js",
  "types": "build/api.d.ts",
  "files": [
    "build"
  ],
  "jest": {
    "moduleNameMapper": {
      "\\.(css|less)$": "jest-css-modules"
    }
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development webpack serve",
    "build-dev": "cross-env NODE_ENV=development webpack",
    "build": "cross-env NODE_ENV=production webpack && cp src/api/api.d.ts build",
    "copy-types": "cp src/api/api.d.ts build",
    "full-build": "npm run build && npm run copy-types",
    "prepack": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polina-prokofieva/json-custom-view.git",
    "directory": "packages/core"
  },
  "keywords": [
    "json",
    "json-viewer",
    "json-view",
    "json-display",
    "json-renderer",
    "json-to-html",
    "json-tree",
    "json-table",
    "collapsible",
    "customizable",
    "visualization",
    "vanilla-js",
    "typescript",
    "frontend"
  ],
  "author": "Polina Prokofieva",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/polina-prokofieva/json-custom-view/issues"
  },
  "homepage": "https://github.com/polina-prokofieva/json-custom-view/tree/main/packages/core#readme",
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 1 edge versions"
  ],
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.21.0",
    "@jest/globals": "^29.4.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.3",
    "expect": "^29.3.1",
    "html-loader": "^4.2.0",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.3.1",
    "jest-cli": "^29.3.1",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.3.1",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.4.2",
    "webpack": "^5.75.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "typescript": "^4.9.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
