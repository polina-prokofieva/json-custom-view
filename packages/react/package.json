{
  "name": "@json-custom-view/react",
  "version": "0.1.0",
  "description": "React component for json-custom-view: a customizable JSON viewer that renders JSON as a collapsible tree or tables.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^json-custom-view$": "<rootDir>/../core/src/api/api.ts",
      "\\.(css|less)$": "jest-css-modules"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polina-prokofieva/json-custom-view.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "react-component",
    "json",
    "json-viewer",
    "json-view",
    "react-json-view",
    "json-tree",
    "json-table",
    "json-renderer",
    "collapsible",
    "customizable",
    "visualization",
    "typescript",
    "json-custom-view"
  ],
  "author": "Polina Prokofieva",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/polina-prokofieva/json-custom-view/issues"
  },
  "homepage": "https://github.com/polina-prokofieva/json-custom-view/tree/main/packages/react#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "json-custom-view": "^1.2.6"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^29.7.0",
    "@types/react": "^18.3.32",
    "jest": "^29.7.0",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
